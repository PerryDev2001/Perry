rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user that has a document at /admins/{their uid}.
    // Admin documents can only be created in the Firebase console (never from the website).
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins list: each admin can read only their own entry; nobody can write from the site.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Anti-spam: the time of each sender's last message. A visitor's message must be saved
    // together with this stamp (one batch), at least half a second after their previous one,
    // so scripts can't flood the chat. Nobody can read it.
    function throttled() {
      return getAfter(/databases/$(database)/documents/throttle/$(request.auth.uid)).data.at == request.time &&
        (!exists(/databases/$(database)/documents/throttle/$(request.auth.uid)) ||
          request.time > get(/databases/$(database)/documents/throttle/$(request.auth.uid)).data.at + duration.value(500, 'ms'));
    }

    match /throttle/{uid} {
      allow read: if false;
      allow create, update: if
        request.auth != null &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['at']) &&
        request.resource.data.at == request.time;
    }

    // Public chat: anyone can read and post; only admins can delete; nobody can edit.
    // Admins can also post as their profile (admin: true), which nobody else can.
    match /messages/{messageId} {
      allow read: if true;

      allow create: if
        isAdmin() &&
        request.resource.data.keys().hasOnly(['name', 'text', 'admin', 'uid', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'text', 'admin', 'uid', 'createdAt']) &&
        request.resource.data.admin == true &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.createdAt == request.time;

      // Visitors post with their (anonymous) sign-in, within the spam limit
      allow create: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'device', 'country', 'countryName', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'text', 'uid', 'device', 'country', 'countryName', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        throttled() &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.device is string &&
        request.resource.data.device.size() <= 40 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 2 &&
        request.resource.data.countryName is string &&
        request.resource.data.countryName.size() <= 56 &&
        request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Visitors: one document per visitor (keyed by a one-way IP code or a browser key).
    // "fp" is a one-way code of the device, used to recognise the same device again.
    // Anyone can read the list. A first visit creates the document; later visits may only
    // refresh lastSeen (and fp). Only admins can delete.
    match /visits/{visitId} {
      allow read: if true;

      allow create: if
        visitId.matches('^(ip|b)-[a-f0-9]{16,64}$') &&
        request.resource.data.keys().hasOnly(['device', 'country', 'countryName', 'fp', 'createdAt', 'lastSeen']) &&
        (!('fp' in request.resource.data) ||
          (request.resource.data.fp is string && request.resource.data.fp.size() <= 64)) &&
        request.resource.data.keys().hasAll(['device', 'country', 'countryName', 'createdAt', 'lastSeen']) &&
        request.resource.data.device is string &&
        request.resource.data.device.size() <= 40 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 2 &&
        request.resource.data.countryName is string &&
        request.resource.data.countryName.size() <= 56 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.lastSeen == request.time;

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'fp']) &&
        (!('fp' in request.resource.data) ||
          (request.resource.data.fp is string && request.resource.data.fp.size() <= 64)) &&
        request.resource.data.lastSeen == request.time;

      allow delete: if isAdmin();
    }

    // Visitor IP addresses: private. Only admins can read them. Each visit saves its own
    // (the document ID is the visit's), and only for a visit that exists.
    match /visitIps/{visitId} {
      allow read, delete: if isAdmin();

      allow create, update: if
        exists(/databases/$(database)/documents/visits/$(visitId)) &&
        request.resource.data.keys().hasOnly(['ip', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['ip', 'updatedAt']) &&
        request.resource.data.ip is string &&
        request.resource.data.ip.size() > 0 &&
        request.resource.data.ip.size() <= 45 &&
        request.resource.data.updatedAt == request.time;
    }

    // Comments on the pinned post, any post, or an approved visitor post: anyone can read. Posting needs an (anonymous) sign-in;
    // the author can edit the text or delete it, and admins can delete any comment.
    match /comments/{commentId} {
      allow read: if true;

      allow create: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['post', 'uid', 'name', 'text', 'device', 'country', 'countryName', 'createdAt']) &&
        request.resource.data.keys().hasAll(['post', 'uid', 'name', 'text', 'device', 'country', 'countryName', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.post is string &&
        request.resource.data.post.size() <= 40 &&
        (request.resource.data.post == 'pinned' ||
          exists(/databases/$(database)/documents/posts/$(request.resource.data.post)) ||
          (exists(/databases/$(database)/documents/submissions/$(request.resource.data.post)) &&
            get(/databases/$(database)/documents/submissions/$(request.resource.data.post)).data.status == 'approved')) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.device is string &&
        request.resource.data.device.size() <= 40 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 2 &&
        request.resource.data.countryName is string &&
        request.resource.data.countryName.size() <= 56 &&
        request.resource.data.createdAt == request.time;

      allow update: if
        request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 300 &&
        request.resource.data.editedAt == request.time;

      allow delete: if
        isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Posts shown on the profile page: anyone can read; only admins can write (text only for now).
    match /posts/{postId} {
      allow read: if true;

      allow create: if
        isAdmin() &&
        request.resource.data.keys().hasOnly(['text', 'createdAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Site settings (the public profile, the pinned post on/off): anyone can read; only admins can change.
    match /site/{docId} {
      allow read: if true;

      allow write: if
        isAdmin() &&
        docId == 'profile' &&
        request.resource.data.keys().hasOnly(['name', 'role', 'bio', 'bioRef', 'updatedAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.role is string &&
        request.resource.data.role.size() <= 60 &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 300 &&
        request.resource.data.bioRef is string &&
        request.resource.data.bioRef.size() <= 60 &&
        request.resource.data.updatedAt == request.time;

      // Pinned post on/off
      allow write: if
        isAdmin() &&
        docId == 'pinned' &&
        request.resource.data.keys().hasOnly(['pinned', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['pinned', 'updatedAt']) &&
        request.resource.data.pinned is bool &&
        request.resource.data.updatedAt == request.time;
    }

    // Likes: one per device (anonymous sign-in) per post. The document ID must be
    // "{post}_{the device's uid}", so a device can't like the same post twice.
    // Anyone can read; a device can only add or remove its own like.
    match /likes/{likeId} {
      allow read: if true;

      allow create: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['post', 'uid', 'device', 'createdAt']) &&
        request.resource.data.keys().hasAll(['post', 'uid', 'device', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.post is string &&
        request.resource.data.post.size() > 0 &&
        request.resource.data.post.size() <= 40 &&
        likeId == request.resource.data.post + '_' + request.auth.uid &&
        request.resource.data.device is string &&
        request.resource.data.device.size() <= 40 &&
        request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if
        isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Visitor posts: anyone (anonymous sign-in) can send one; it starts as "pending".
    // Everyone can read approved ones; pending ones are visible only to admins and their author.
    // Only admins can approve / unpublish (status) or delete.
    match /submissions/{postId} {
      allow read: if
        resource.data.status == 'approved' ||
        isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if
        request.auth != null &&
        request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'device', 'country', 'countryName', 'status', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'text', 'uid', 'device', 'country', 'countryName', 'status', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000 &&
        request.resource.data.device is string &&
        request.resource.data.device.size() <= 40 &&
        request.resource.data.country is string &&
        request.resource.data.country.size() <= 2 &&
        request.resource.data.countryName is string &&
        request.resource.data.countryName.size() <= 56 &&
        request.resource.data.createdAt == request.time;

      allow update: if
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']) &&
        request.resource.data.status in ['pending', 'approved'] &&
        request.resource.data.reviewedAt == request.time;

      allow delete: if isAdmin();
    }

    // A message reaction: one of six emoji, from the signed-in person (only admins can mark it admin)
    function validReaction(d) {
      return d.keys().hasOnly(['msg', 'uid', 'emoji', 'name', 'admin', 'createdAt']) &&
        d.keys().hasAll(['msg', 'uid', 'emoji', 'name', 'admin', 'createdAt']) &&
        d.uid == request.auth.uid &&
        d.emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏'] &&
        d.name is string &&
        d.name.size() <= 60 &&
        d.admin is bool &&
        (d.admin == false || isAdmin()) &&
        d.createdAt == request.time;
    }

    // Private messages: one conversation per visitor, stored under their anonymous sign-in id.
    // Only that visitor and admins can read or write it, so nobody else can see these messages.
    function validDmThread(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 24 &&
        d.device is string && d.device.size() <= 40 &&
        d.country is string && d.country.size() <= 2 &&
        d.countryName is string && d.countryName.size() <= 56 &&
        d.lastText is string && d.lastText.size() <= 120 &&
        d.lastFrom == 'visitor' &&
        d.updatedAt == request.time;
    }

    match /dms/{threadId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == threadId);

      allow create: if
        request.auth != null &&
        request.auth.uid == threadId &&
        request.resource.data.keys().hasOnly(['name', 'device', 'country', 'countryName', 'lastText', 'lastFrom', 'updatedAt']) &&
        request.resource.data.keys().hasAll(['name', 'device', 'country', 'countryName', 'lastText', 'lastFrom', 'updatedAt']) &&
        validDmThread(request.resource.data);

      allow update: if
        (request.auth != null &&
          request.auth.uid == threadId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'device', 'country', 'countryName', 'lastText', 'lastFrom', 'updatedAt']) &&
          validDmThread(request.resource.data)) ||
        (isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastText', 'lastFrom', 'updatedAt', 'adminReadAt']) &&
          request.resource.data.lastText is string &&
          request.resource.data.lastText.size() <= 120);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == threadId);

        allow create: if
          request.auth != null &&
          request.resource.data.keys().hasOnly(['from', 'text', 'createdAt']) &&
          request.resource.data.keys().hasAll(['from', 'text', 'createdAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 1000 &&
          request.resource.data.createdAt == request.time &&
          ((request.auth.uid == threadId && request.resource.data.from == 'visitor' && throttled()) ||
            (isAdmin() && request.resource.data.from == 'admin'));

        allow update: if false;
        allow delete: if isAdmin();
      }

      // Reactions in a private chat: only the visitor and admins can see or add them.
      match /reactions/{reactionId} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == threadId);

        allow create, update: if
          request.auth != null &&
          (isAdmin() || request.auth.uid == threadId) &&
          request.resource.data.msg is string &&
          request.resource.data.msg.size() > 0 &&
          request.resource.data.msg.size() <= 40 &&
          reactionId == request.resource.data.msg + '_' + request.auth.uid &&
          exists(/databases/$(database)/documents/dms/$(threadId)/messages/$(request.resource.data.msg)) &&
          validReaction(request.resource.data);

        allow delete: if
          isAdmin() ||
          (request.auth != null && request.auth.uid == threadId && resource.data.uid == request.auth.uid);
      }
    }

    // Reactions on Community Chat messages: one per person per message ("{message}_{uid}").
    // Anyone can see them; you can add, change or remove only your own (admins can remove any).
    match /chatReactions/{reactionId} {
      allow read: if true;

      allow create, update: if
        request.auth != null &&
        request.resource.data.msg is string &&
        request.resource.data.msg.size() > 0 &&
        request.resource.data.msg.size() <= 40 &&
        reactionId == request.resource.data.msg + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/messages/$(request.resource.data.msg)) &&
        validReaction(request.resource.data);

      allow delete: if
        isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
